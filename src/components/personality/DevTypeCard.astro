---
import { Image } from "astro:assets";
import CardWrapper from "./CardWrapper.astro";
import type { PersonalitySummary } from "@/types/personality";
import "../../styles/animations.css";

type Props = {
  title: PersonalitySummary["title"];
};

const { title } = Astro.props;

// Emoji mapping for different developer types
const typeEmojis = {
  RETRO: "🕹️",
  MINIMALIST: "✨",
  TRADITIONALIST: "📚",
  PRAGMATIST: "🛠️",
  MARIEKONDO: "✨",
  // Add more mappings as needed
};

const emoji = typeEmojis[title.toUpperCase()] || "🌟";
---

<CardWrapper name="type" classes="border-2 border-accent-bluemedium backdrop-blur-lg">
  <div class="grid gap-6 place-items-center py-8 px-4 relative">
    <!-- Celebratory header -->
    <div class="text-center">
      <p class="text-2xl text-indigo-600 font-semibold mb-2 animate-bounce">
        {emoji} Congratulations! {emoji}
      </p>
      <p class="text-xl text-indigo-500/80">You are a...</p>
    </div>

    <!-- Developer type image -->
    <div class="relative">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-400/20 to-purple-400/20 rounded-full blur-xl transform scale-110 animate-pulse"></div>
      <Image
        src={`/images/${title.toLowerCase()}.png`}
        width={200}
        height={200}
        alt={title}
        class="size-40 sm:size-48 relative z-10 transform hover:scale-110 transition-transform duration-300"
      />
    </div>

    <!-- Developer type title -->
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent transform hover:scale-105 transition-transform duration-300">
        {title}
      </h2>
      <p class="text-xl text-indigo-600/80 mt-2 font-medium tracking-wide">
        Developer
      </p>
    </div>

    <!-- Decorative elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
      <div class="absolute top-4 left-4 w-24 h-24 bg-indigo-200/20 rounded-full mix-blend-multiply filter blur-xl"></div>
      <div class="absolute bottom-4 right-4 w-24 h-24 bg-purple-200/20 rounded-full mix-blend-multiply filter blur-xl"></div>
    </div>
  </div>
</CardWrapper>

