---
import type { PersonalitySummary } from '../types/types';
import DevTypeCard from './DevTypeCard.astro';
import DescriptionCard from './DescriptionCard.astro';
import CustomPieChart from './CustomPieChart';
import FriendsCard from './FriendsCard.astro';
import SimilarCard from './SimilarCard.astro';
import PopularCard from './PopularCard.astro';
import CardWrapper from './CardWrapper.astro';

interface Props {
  personalitySummary: PersonalitySummary;
}

const { personalitySummary } = Astro.props;
---

<div class="relative">
  <!-- Main developer type card - centered and prominent -->
  <div class="flex justify-center mb-12 transform hover:scale-105 transition-all duration-300">
    <div class="w-full max-w-2xl">
      <DevTypeCard developerType={personalitySummary.developerType} />
    </div>
  </div>

  <!-- Supporting cards in a playful layout -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <!-- Description card spanning two columns -->
    <div class="lg:col-span-2 transform hover:-rotate-1 transition-all duration-300">
      <DescriptionCard description={personalitySummary.description} />
    </div>

    <!-- Friends card with slight rotation -->
    <div class="transform hover:rotate-1 transition-all duration-300">
      <FriendsCard friendsWith={personalitySummary.friendsWith} />
    </div>

    <!-- Pie chart with hover effect -->
    <div class="transform hover:-translate-y-2 transition-all duration-300">
      <CardWrapper name="distribution">
        <CustomPieChart client:load typeBreakdown={personalitySummary.typeBreakdown} />
      </CardWrapper>
    </div>

    <!-- Similar and Popular cards with subtle animations -->
    <div class="transform hover:translate-y-2 transition-all duration-300">
      <SimilarCard percentileSimilarToType={personalitySummary.percentileSimilarToType} />
    </div>

    <div class="transform hover:-translate-y-2 transition-all duration-300">
      <PopularCard mostPopularPackage={personalitySummary.mostPopularPackage} />
    </div>
  </div>

  <!-- Decorative background elements -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-purple-200/30 rounded-full mix-blend-multiply filter blur-xl animate-blob"></div>
    <div class="absolute top-1/3 right-1/3 w-64 h-64 bg-yellow-200/30 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-2000"></div>
    <div class="absolute bottom-1/4 left-1/2 w-64 h-64 bg-pink-200/30 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-4000"></div>
  </div>
</div>

<style>
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>
