---
import PersonalityLayout from './components/PersonalityLayout.astro';
import { DeveloperPersonalityType } from './types/types';

// Sample personality data
const personalityData = {
  developerType: DeveloperPersonalityType.Retro,
  description: "You're a developer who appreciates tried-and-true methods and established patterns. Like a master craftsperson, you value reliability and proven solutions over cutting-edge experiments. Your code is typically well-documented and maintainable, drawing from years of community wisdom.",
  friendsWith: [
    DeveloperPersonalityType.Traditionalist,
    DeveloperPersonalityType.Pragmatist,
    DeveloperPersonalityType.MarieKondo
  ],
  percentileSimilarToType: 15,
  mostPopularPackage: "lodash",
  typeBreakdown: {
    frontend: 30,
    backend: 25,
    fullstack: 20,
    devops: 15,
    other: 10
  }
};
---

<div class="min-h-screen bg-gray-900 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-white mb-4">Your Developer Personality</h1>
      <p class="text-xl text-white/70">Discover your unique development style and preferences</p>
    </div>
    <PersonalityLayout personalitySummary={personalityData} />
  </div>
</div>

